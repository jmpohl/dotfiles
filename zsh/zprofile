if [[ -z $DISPLAY ]] && [[ $(tty) = /dev/tty1 ]]; then
	exec startx;
fi

export PATH="$HOME/bin:$PATH"
export PATH="$HOME/bin/statusbar:$PATH"
#export PATH="$PATH:/opt/cisco/anyconnect/bin"
export PATH="$PATH:$HOME/src/dwm"
export PATH="$PATH:$HOME/src/st"
export PATH="$PATH:/home/josie/.local/bin"
export PATH="$PATH:/home/josie/src/jai/bin"
#export PATH="$HOME/.local/Slippi-FM-r18/netplay:$PATH"
export EDITOR="kak_session"
export SRC=$HOME/src
export TERM=xterm-256color
export BROWSER=google-chrome-stable
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local"

# global npm installs (currently just the pi coding agent CLI — see the
# fallback install-configs.sh / Nix home.nix activation script) go to a
# user-local prefix, not the Nix store, since npm packages aren't Nix-managed
export NPM_CONFIG_PREFIX="$HOME/.local/npm-global"
export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"

# skak/skaf fzf/ag config
export FZF_DEFAULT_OPTS='
 --color=fg:#d1d1d1,bg:#0a0909,hl:#d6c22b
 --color=fg+:#ffffff,bg+:#2a2a2a,hl+:#ebd636
 --color=info:#bf658c,prompt:#d7005f,pointer:#21c8ff
 --color=marker:#40bdd6,spinner:#d7005f,header:#87afaf'
export FZF_DEFAULT_COMMAND="find . -type f ! -path '*/\.git/*' ! -path '*/\node_modules/*'"

# Python, don't create __pycache__
export PYTHONDONTWRITEBYTECODE=1

# `ls` colors
export LS_COLORS=$LS_COLORS:'di=1;96:'

# pyenv (only if installed)
if command -v pyenv >/dev/null 2>&1 || [[ -d "$HOME/.pyenv" ]]; then
    export PYENV_ROOT="$HOME/.pyenv"
    command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
fi

export JIRA_API_TOKEN="6320OXnw6QnuL30IAofI858E"

# Machine/employer-specific env vars that don't belong in a shared, public
# repo (e.g. an internal NIX_PATH override, a company GOPATH/dx-tool setup)
# go in ~/.zprofile.local instead. Not tracked by this repo (see .gitignore)
# — create it by hand per machine. Sourced last so it can override anything
# above.
[[ -r "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"
